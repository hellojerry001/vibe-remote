{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VibeRemote",
  "version": "0.2.2",
  "identifier": "com.webcoding.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:2410",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "VibeRemote",
        "width": 960,
        "height": 660,
        "minWidth": 760,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://raw.githubusercontent.com/hellojerry001/vibe-remote/main/update.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQzNzhCNEQ0QjkyQjJBNDMKUldSREtpdTUxTFI0UTA2emY3eFdGcERsZXZ0dTMvYkVhc1FjM25CNllHT3B0UEpDSHlmZklxNkgK"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.icns",
      "icons/icon.png",
      "icons/icon@2x.png",
      "icons/icon-1024.png"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": false
    }
  }
}
