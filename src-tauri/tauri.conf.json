{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WebCoding",
  "version": "0.1.0",
  "identifier": "com.webcoding.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:2410",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Web Coding",
        "width": 960,
        "height": 660,
        "minWidth": 760,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png",
      "icons/icon@2x.png",
      "icons/icon-1024.png"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": false
    }
  }
}
